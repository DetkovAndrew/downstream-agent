# Скопируйте в .env и вставьте ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Несколько ключей через запятую (перебираются; квота считается на проект, не на ключ)
GEMINI_API_KEYS=
# Запасные модели при суточном лимите основной
GEMINI_FALLBACK=gemini-3.5-flash
# Модель: посмотреть доступные можно командой  python -m downstream_agent models
GEMINI_MODEL=gemini-3.1-flash-lite
# auto = Gemini, если есть ключ, иначе локальный Ollama; gemini | ollama — принудительно
AGENT_BACKEND=auto

# YandexGPT (Яндекс Облако): включается AGENT_BACKEND=yandex; доступен только напрямую из России
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# NewsAPI.org (бесплатно: 100 запросов/сутки, статьи до месяца, задержка ~сутки)
NEWSAPI_KEY=

# GigaChat (Сбер): AGENT_BACKEND=gigachat; ключ авторизации из личного кабинета, работает без VPN
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
